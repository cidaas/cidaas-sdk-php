# general data for all tests, required to access cidaas instance
# Use placeholders for unit tests. For integration tests, copy to a local file
# (gitignored) and fill in real values — never commit secrets.
CIDAAS_BASE_URL=https://nightlybuild.cidaas.de
CIDAAS_BASE_URL_WITH_PROXY=http://localhost:3000
CIDAAS_CLIENT_ID=00000000-0000-0000-0000-000000000001
CIDAAS_CLIENT_SECRET=00000000-0000-0000-0000-000000000002
CIDAAS_REDIRECT_URI=http://localhost:8000

# Fixture email must match mock JWT/profile responses in tests (not a live credential).
USER_NAME=user@widas.de
PASSWORD=changeme
USERNAME_TYPE=email
